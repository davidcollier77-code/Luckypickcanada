{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luckypickcanada-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "routes": [
    {
      "pattern": "luckypickcanada.ca",
      "custom_domain": true
    },
    {
      "pattern": "www.luckypickcanada.ca",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "luckypickcanada-app"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "GIFT_FROM_EMAIL": "gifts@luckypickcanada.ca"
  }
}
