{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luckypickcanada-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "routes": [
    {
      "pattern": "luckypickcanada.ca",
      "custom_domain": true
    },
    {
      "pattern": "www.luckypickcanada.ca",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "luckypickcanada-app"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "luckypickcanada-cache"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_id": "f68f4ddd-9a4d-486b-97bf-1093b35378d4",
      "database_name": "luckypickcanada-tags"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "GIFT_FROM_EMAIL": "gifts@luckypickcanada.ca"
  }
}
